{
  "name": "@yzi-yzi/lucide-extensions",
  "version": "0.1.0",
  "description": "Independent filled and duotone extensions for 1,890 Lucide icons, with SVG assets and React components.",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/yzi-yzi/lucide-extensions.git"
  },
  "files": [
    "dist",
    "icons",
    "metadata",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    "./react/filled": {
      "types": "./dist/react/filled/index.d.ts",
      "import": "./dist/react/filled/index.js",
      "require": "./dist/react/filled/index.cjs"
    },
    "./react/duotone": {
      "types": "./dist/react/duotone/index.d.ts",
      "import": "./dist/react/duotone/index.js",
      "require": "./dist/react/duotone/index.cjs"
    },
    "./react/filled/*": {
      "types": "./dist/react/filled/*.d.ts",
      "import": "./dist/react/filled/*.js",
      "require": "./dist/react/filled/*.cjs"
    },
    "./react/duotone/*": {
      "types": "./dist/react/duotone/*.d.ts",
      "import": "./dist/react/duotone/*.js",
      "require": "./dist/react/duotone/*.cjs"
    },
    "./core/filled/*": {
      "types": "./dist/core/filled/*.d.ts",
      "import": "./dist/core/filled/*.js",
      "require": "./dist/core/filled/*.cjs"
    },
    "./core/duotone/*": {
      "types": "./dist/core/duotone/*.d.ts",
      "import": "./dist/core/duotone/*.js",
      "require": "./dist/core/duotone/*.cjs"
    },
    "./filled/*": "./icons/filled/*",
    "./duotone/*": "./icons/duotone/*",
    "./metadata/*": "./metadata/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs && vite build --config apps/web/vite.config.js",
    "dev": "node scripts/build-web.mjs && vite --config apps/web/vite.config.js --host 127.0.0.1",
    "test": "node --test scripts/library.test.mjs && tsc",
    "check": "npm run build && npm test && npm run typecheck:web && npm run build:web",
    "prepack": "npm run build",
    "build:pages": "node scripts/build-web.mjs && vite build --config apps/web/vite.config.js --base=/lucide-extensions/",
    "typecheck:web": "tsc -p apps/web/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://lucide-extensions.vercel.app/",
  "bugs": {
    "url": "https://github.com/yzi-yzi/lucide-extensions/issues"
  },
  "keywords": [
    "icons",
    "lucide",
    "filled",
    "duotone",
    "svg",
    "react",
    "typescript",
    "tree-shaking"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
